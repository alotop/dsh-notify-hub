{
  "name": "@alotop/dsh-notify-hub",
  "version": "0.3.0",
  "description": "通知集合（Notification Hub）：DSH Host 端通知中枢，整合 Bark 推送、多路 Webhook（飞书自定义关键词与签名校验 / 企微 / 钉钉 / Slack / Discord / 自定义）、原生桌面通知，并新增「移动新消息」5G 消息推送通道。设置页通过专用 RPC 读写 Host 配置，全部密钥脱敏不回传浏览器。",
  "license": "MIT",
  "author": "alotop",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alotop/dsh-notify-hub.git"
  },
  "bugs": {
    "url": "https://github.com/alotop/dsh-notify-hub/issues"
  },
  "homepage": "https://github.com/alotop/dsh-notify-hub#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:tap": "node --test tests/",
    "check:client": "node scripts/check-client.mjs",
    "check": "node scripts/check-client.mjs && node scripts/run-tests.mjs",
    "pack:check": "npm pack --dry-run --json > pack.json && node scripts/inspect-tarball.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notification",
    "bark",
    "webhook",
    "feishu",
    "wecom",
    "cmcc",
    "5g-message"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
