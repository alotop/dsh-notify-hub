# Local live-check credentials — COPY this file to `.env` and fill in real values.
#
#   cp .env.example .env        # .env is gitignored and never published
#   npm run live-check          # sends ONE test notification per configured channel
#
# Every value below is a FAKE placeholder. Real credentials belong in `.env`
# only: a committed file must never carry one, because a value that reaches git
# history cannot be deleted reliably and may also reach the npm tarball.
# `npm run check` enforces that rule (scripts/check-repo-hygiene.mjs).
#
# A channel with its variables unset is SKIPPED, so it is fine to configure only
# the one you are working on.
#
# --- Bark (https://api.day.app/<device-key>) --------------------------------
DSH_NOTIFY_HUB_BARK_URL=https://api.day.app/PLACEHOLDER
DSH_NOTIFY_HUB_BARK_GROUP=DSH live check

# --- 移动新消息 / China Mobile 5G message -----------------------------------
# Keys are issued as ak_... or app_...
DSH_NOTIFY_HUB_CMCC_API_KEY=ak_replace_me
DSH_NOTIFY_HUB_CMCC_TO=13800138000

# --- 飞书 / Feishu custom bot -----------------------------------------------
DSH_NOTIFY_HUB_FEISHU_URL=https://open.feishu.cn/open-apis/bot/v2/hook/PLACEHOLDER
# Optional: the bot's 自定义关键词 (must match what the console has).
DSH_NOTIFY_HUB_FEISHU_KEYWORD=dsh-notify-hub
# Optional: the bot's 签名校验 secret.
DSH_NOTIFY_HUB_FEISHU_SECRET=
# Optional: a Webhook URL for the generic `custom` preset.
DSH_NOTIFY_HUB_CUSTOM_URL=

# --- Desktop -----------------------------------------------------------------
# 1 pops a real desktop notification from the live check.
DSH_NOTIFY_HUB_LOCAL=0
